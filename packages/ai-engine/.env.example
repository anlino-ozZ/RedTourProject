# ===== ai-engine 环境变量示例 =====
# 复制本文件为 .env 并填写真实值

# ---- Ollama 本地大模型 ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REASONING_MODEL=qwen2.5:7b       # 规划阶段模型
OLLAMA_LIGHT_MODEL=qwen2.5:7b           # 最终回答阶段模型，可配置更轻量模型
OLLAMA_TIMEOUT_SECONDS=5                # 单次 Ollama 请求超时
OLLAMA_KEEP_ALIVE=30m                   # 模型常驻时间，避免每次请求重新加载
OLLAMA_REASONING_MAX_TOKENS=128         # 规划阶段最大输出 token
OLLAMA_ANSWER_MAX_TOKENS=256            # 最终回答最大输出 token

# ---- LLM Wiki 知识库 ----
WIKI_DIR=./wiki              # 原始素材目录（党史/地方志/老兵家书等）
WIKI_BUILD_DIR=./wiki_build  # 编译产物目录（结构化 Markdown 百科）
WIKI_MAX_CONTEXT_CHARS=6000  # 单次问答最多注入的 Wiki 字符数

# ---- 本地 TTS ----
AUDIO_DIR=./audio           # 受控音频输出目录
AUDIO_URL_PREFIX=/audio/tts # 对外返回的相对音频 URL 前缀

# ---- 本地 STT ----
STT_MODEL=small                    # faster-whisper 模型名或本地模型目录
STT_MODEL_DIR=./models             # 已预下载模型缓存目录
STT_DEVICE=auto                    # auto / cpu / cuda
STT_COMPUTE_TYPE=int8              # CPU 默认使用 int8
STT_LANGUAGE=zh                    # 默认识别语言
STT_LOCAL_FILES_ONLY=true          # 离线运行，不在请求期间下载模型
STT_TEMP_DIR=./stt_temp            # 受控临时音频目录
STT_MAX_FILE_MB=20                 # 单个上传音频大小上限
STT_MAX_DURATION_SECONDS=60        # 单个上传音频时长上限

# ---- Hailo8L 硬件加速 ----
HAILO_ENABLED=false          # 是否启用 Hailo8L 加速（仅树莓派环境设为 true）
HAILO_POSE_HEF=./weights/yolov8n_pose_h8l.hef # Hailo8L 轻量姿态 HEF 模型
HAILO_POSE_CONFIDENCE=0.25   # Hailo 人体检测置信度下限
HAILO_POSE_KEYPOINT_ORDER=yx # HEF 关键点坐标顺序：yx / xy

# ---- YOLOv8-pose 权重 ----
YOLO_WEIGHTS=./weights/yolov8s-pose.pt
POSE_MAX_IMAGE_MB=10        # Base64 解码后的图片大小上限
POSE_MAX_PIXELS=12000000    # 解码图片最大像素数，防止压缩炸弹
POSE_WS_MAX_MESSAGE_CHARS=14100000 # WebSocket 单帧 JSON 字符上限
POSE_WS_MAX_CONNECTIONS=20         # AI 引擎最大姿态流连接数
POSE_WS_IDLE_TIMEOUT_SECONDS=60    # WebSocket 空闲关闭时间
POSE_TARGET_FPS=30                 # Hailo 姿态性能目标
POSE_PERF_WINDOW_FRAMES=30         # FPS 统计窗口帧数

# ---- 问答性能目标 ----
ASK_TARGET_MS=3000                 # 常规问答目标耗时
ASK_OFFLINE_LIMIT_MS=5000          # 离线模型受限时的宽限耗时

# ---- 引擎服务端口 ----
ENGINE_PORT=8001

# ---- 健康检查 ----
HEALTH_CHECK_TIMEOUT_SECONDS=1.0  # 外部依赖探测超时（秒）
