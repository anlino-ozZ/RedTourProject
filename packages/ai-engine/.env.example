# ===== ai-engine 环境变量示例 =====
# 复制本文件为 .env 并填写真实值

# ---- Ollama 本地大模型 ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 规划阶段模型
OLLAMA_REASONING_MODEL=qwen2.5:7b
# 最终回答阶段模型，可配置更轻量模型
OLLAMA_LIGHT_MODEL=qwen2.5:7b
# 单次 Ollama 请求超时
OLLAMA_TIMEOUT_SECONDS=5
# 模型常驻时间，避免每次请求重新加载
OLLAMA_KEEP_ALIVE=30m
# 规划阶段最大输出 token
OLLAMA_REASONING_MAX_TOKENS=128
# 最终回答最大输出 token
OLLAMA_ANSWER_MAX_TOKENS=256

# ---- 云端大模型（可选，仅开发机联网调试；树莓派离线部署保持 ollama）----
# 切换开关：ollama=本地离线（默认，树莓派必须保持） / cloud=走云端 OpenAI 兼容接口
LLM_PROVIDER=ollama
# 复制你的 API Key 到这里（留空则 /engine/health 显示 missing_key，问答自动降级）
LLM_API_KEY=
# OpenAI 兼容端点，末尾不要带 /chat/completions，代码会自动拼接
LLM_BASE_URL=https://api.deepseek.com/v1
# 常用端点示例：
#   DeepSeek  https://api.deepseek.com/v1       模型 deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   智谱       https://open.bigmodel.cn/api/paas/v4              模型 glm-4-flash
#   OpenAI     https://api.openai.com/v1                         模型 gpt-4o-mini
LLM_MODEL=deepseek-chat
# 规划阶段模型，留空则复用 LLM_MODEL
LLM_REASONING_MODEL=
# 润色阶段模型，留空则复用 LLM_MODEL
LLM_LIGHT_MODEL=
# 单次云端请求超时（秒）
LLM_TIMEOUT_SECONDS=30
# 云端输出预算：本地默认 128/256 偏小，推理型模型的思考过程会耗尽预算导致返回空回答
LLM_REASONING_MAX_TOKENS=512
LLM_ANSWER_MAX_TOKENS=1024
# 注意事项：
#   1. .env 不要写 KEY=value  # 注释，行内注释会被当成值的一部分（模型名被污染会请求失败）
#   2. 模型名以厂商返回的可用列表为准，填错会返回 HTTP 400，错误信息里会列出该 Key 支持的模型
#   3. 后端 ai-engine.read-timeout-ms（仓库默认 30000）要大于一次问答总耗时，
#      云端含规划+润色两次调用，实测约 7s，慢模型建议调到 90000

# ---- LLM Wiki 知识库 ----
# 原始素材目录（党史/地方志/老兵家书等）
WIKI_DIR=./wiki
# 编译产物目录（结构化 Markdown 百科）
WIKI_BUILD_DIR=./wiki_build
# 单次问答最多注入的 Wiki 字符数
WIKI_MAX_CONTEXT_CHARS=6000

# ---- 本地 TTS ----
# 受控音频输出目录
AUDIO_DIR=./audio
# 对外返回的相对音频 URL 前缀
AUDIO_URL_PREFIX=/audio/tts

# ---- 本地 STT ----
# faster-whisper 模型名或本地模型目录
STT_MODEL=small
# 已预下载模型缓存目录
STT_MODEL_DIR=./models
# auto / cpu / cuda
STT_DEVICE=auto
# CPU 默认使用 int8
STT_COMPUTE_TYPE=int8
# 默认识别语言
STT_LANGUAGE=zh
# 离线运行，不在请求期间下载模型
STT_LOCAL_FILES_ONLY=true
# 受控临时音频目录
STT_TEMP_DIR=./stt_temp
# 单个上传音频大小上限
STT_MAX_FILE_MB=20
# 单个上传音频时长上限
STT_MAX_DURATION_SECONDS=60

# ---- Hailo8L 硬件加速 ----
# 是否启用 Hailo8L 加速（仅树莓派环境设为 true）
HAILO_ENABLED=false
# Hailo8L 轻量姿态 HEF 模型
HAILO_POSE_HEF=./weights/yolov8n_pose_h8l.hef
# Hailo 人体检测置信度下限
HAILO_POSE_CONFIDENCE=0.25
# HEF 关键点坐标顺序：yx / xy
HAILO_POSE_KEYPOINT_ORDER=yx

# ---- YOLOv8-pose 权重 ----
YOLO_WEIGHTS=./weights/yolov8s-pose.pt
# Base64 解码后的图片大小上限
POSE_MAX_IMAGE_MB=10
# 解码图片最大像素数，防止压缩炸弹
POSE_MAX_PIXELS=12000000
# WebSocket 单帧 JSON 字符上限
POSE_WS_MAX_MESSAGE_CHARS=14100000
# AI 引擎最大姿态流连接数
POSE_WS_MAX_CONNECTIONS=20
# WebSocket 空闲关闭时间
POSE_WS_IDLE_TIMEOUT_SECONDS=60
# Hailo 姿态性能目标
POSE_TARGET_FPS=30
# FPS 统计窗口帧数
POSE_PERF_WINDOW_FRAMES=30

# ---- 问答性能目标 ----
# 常规问答目标耗时
ASK_TARGET_MS=3000
# 离线模型受限时的宽限耗时
ASK_OFFLINE_LIMIT_MS=5000

# ---- 引擎服务端口 ----
ENGINE_PORT=8001

# ---- 健康检查 ----
# 外部依赖探测超时（秒）
HEALTH_CHECK_TIMEOUT_SECONDS=1.0
