# ===== hardware-rpi 环境变量示例 =====
# 复制本文件为 .env 并填写真实值
# 注意：仅树莓派环境运行

# ---- 串口通信 ----
SERIAL_PORT=/dev/ttyAMA0    # 串口设备路径
BAUDRATE=115200             # 波特率

# ---- 音频播放 ----
AUDIO_DEVICE=default        # 音频输出设备
AUDIO_VOLUME=80             # 初始音量（0-100）
AUDIO_CACHE_DIR=audio_cache # 讲解音频下载缓存目录

# ---- GPIO 引脚 ----
GPIO_LED_PIN=18             # LED 指示灯引脚（BCM 编号）
GPIO_BTN_PIN=17             # 按钮输入引脚（BCM 编号）

# ---- TCP 服务（业务后端 HardwareTcpClient 接入）----
TCP_HOST=0.0.0.0            # 监听地址
TCP_PORT=9000               # 监听端口（与业务后端 hardware.tcp.port 一致）
BUSINESS_BASE_URL=http://localhost:8000  # 业务后端根地址（相对路径音频下载源）

# ---- 主循环 ----
LOOP_INTERVAL=0.5           # 主循环间隔（秒）
